datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

model News {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  date    String
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String   
  email     String   
  message   String   
  createdAt String   
}