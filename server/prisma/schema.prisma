datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"  // ← これに変更
}

generator client {
  provider = "prisma-client-js"
}

// 📢 お知らせの設計図
model News {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  date    String
}

// 📥 お問い合わせの設計図
model Contact {
  id        Int      @id @default(autoincrement())
  name      String   
  email     String   
  message   String   
  createdAt String   
}